<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme tailored for dark purple UI with no action bar -->
    <style name="Theme.MyApplication" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Use our color tokens -->
        <item name="colorPrimary">@color/accent_purple_start</item>
        <item name="colorPrimaryVariant">@color/accent_purple_end</item>
        <item name="colorOnPrimary">@color/text_primary</item>

        <item name="colorSecondary">@color/accent_green</item>
        <item name="colorOnSecondary">@color/text_primary</item>

        <item name="android:statusBarColor">@color/bg_default</item>
        <item name="android:navigationBarColor">@color/bg_default</item>

        <!-- Background/text defaults -->
        <item name="android:colorBackground">@color/bg_default</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:windowBackground">@color/bg_default</item>
    </style>

    <!-- Theme for Login and Register screens with ActionBar showing app title -->
    <style name="Theme.MyApplication.WithActionBar" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Use our color tokens -->
        <item name="colorPrimary">@color/accent_purple_start</item>
        <item name="colorPrimaryVariant">@color/accent_purple_end</item>
        <item name="colorOnPrimary">@color/text_primary</item>

        <item name="colorSecondary">@color/accent_green</item>
        <item name="colorOnSecondary">@color/text_primary</item>

        <item name="android:statusBarColor">@color/bg_default</item>
        <item name="android:navigationBarColor">@color/bg_default</item>

        <!-- Background/text defaults -->
        <item name="android:colorBackground">@color/bg_default</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:windowBackground">@color/bg_default</item>
    </style>

    <!-- Splash Screen Theme -->
    <style name="SplashTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@drawable/splash_gradient_background</item>
    </style>
</resources>